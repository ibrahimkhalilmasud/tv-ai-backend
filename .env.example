# Copy these into Vercel > Project > Settings > Environment Variables.
# NEVER commit a real .env file. This .example file has placeholders only.

# --- AI providers ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXX

# Optional model overrides
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# --- Google OAuth (same client used by the TV app for sign-in) ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- Vector DB: Upstash Vector (free tier) ---
UPSTASH_VECTOR_REST_URL=https://xxxx-xxxx.upstash.io
UPSTASH_VECTOR_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx

# How many document chunks to feed the AI per question
RAG_TOP_K=6
